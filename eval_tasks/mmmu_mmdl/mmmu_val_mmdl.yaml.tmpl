# MMMU validation 본 평가 task (Qwen3-VL-4B-Instruct baseline 및 fine-tune 후 재평가 공용)
#
# 평가 기준은 이 파일과 mmdl_utils.py 에 모두 고정되어 있습니다.
# 동결 이후에는 수정하지 말고, 모델만 바꿔서(scripts/run_mmmu_eval.sh --model_path) 다시 평가합니다.
#
# __MMMU_DATA_ROOT__ 는 scripts/run_mmmu_eval.sh 가 --data_root 값으로 치환합니다.
# 데이터: MMMU/MMMU (HF revision 98e6ac0cb9b7b2cd2c991b85a50762edc4aedc68) 30과목 validation parquet, 900문항
dataset_path: parquet
dataset_kwargs:
  data_files:
    validation: "__MMMU_DATA_ROOT__/*/validation-*.parquet"
task: "mmmu_val_mmdl"
test_split: validation
output_type: generate_until

# 프롬프트: mmdl_utils.py (lmms-eval 의 Qwen3-VL용 MMMU 프롬프트를 수정)
doc_to_text: !function mmdl_utils.mmdl_doc_to_text
doc_to_messages: !function mmdl_utils.mmdl_doc_to_messages
doc_to_visual: !function lmms_eval.tasks.mmmu.utils.mmmu_doc_to_visual
doc_to_target: "answer"

# 채점·집계: lmms-eval 에 포팅된 MMMU 공식 eval_utils (수정 없이 사용)
# 단, 공식 파서에 넘기기 전에 응답의 마지막 "Answer:" 뒤만 추출합니다 (없으면 빈 응답). mmdl_utils.py 참고.
process_results: !function mmdl_utils.mmdl_process_results
metric_list:
  - metric: mmmu_acc
    aggregation: !function lmms_eval.tasks.mmmu.utils.mmmu_aggregate_results
    higher_is_better: true

lmms_eval_specific_kwargs:
  default: &prompts
    pre_prompt: "Question: "
    multiple_choice_prompt: "Think step by step, then give your final answer on the last line in the form \"Answer: X\", where X is the option letter."
    open_ended_prompt: "Think step by step, then give your final answer on the last line in the form \"Answer: <answer>\"."
  # vLLM 백엔드(--model vllm)는 system prompt 를 넣지 않으므로, HF 백엔드(qwen3_vl)가 넣는 것과 같은 문장을 task 에서 넣습니다.
  vllm:
    <<: *prompts
    system_prompt: "You are a helpful assistant."

# 생성 설정: Qwen 공식 Instruct recipe (https://github.com/QwenLM/Qwen3-VL README "Generation Hyperparameters")
#   greedy=false, seed=3407, top_p=0.8, top_k=20, temperature=0.7,
#   repetition_penalty=1.0, presence_penalty=1.5, out_seq_length=32768
# - 본 평가 백엔드는 vLLM 입니다 (scripts/run_mmmu_eval.sh --backend vllm). recipe 전체가 적용됩니다.
#   seed 는 스크립트가 요청별 sampling seed 로 넘깁니다 (--seeds, 본 평가: 3407 1 2).
#   HF transformers 백엔드(--backend hf)는 temperature/top_p/top_k 만 generate() 에 전달하므로
#   presence_penalty 가 적용되지 않습니다 (repetition_penalty=1.0 은 no-op).
# - max_new_tokens: 공식 out_seq_length 32768 대신 16384 를 씁니다.
#   5과목 150문항 pilot(vLLM, seed 3407, 32768)에서 16384 를 넘겨 결론에 도달한 응답은 1개뿐이었고
#   (16384 로 잘랐을 때 잘림 12개 vs 32768 에서 11개), 생성 시간은 약 1/3 입니다.
#   근거: results/runs/M3b_pilot_vllm_32768 (pilot 로그)
generation_kwargs:
  max_new_tokens: 16384
  temperature: 0.7
  top_p: 0.8
  top_k: 20
  repetition_penalty: 1.0
  presence_penalty: 1.5

metadata:
  version: 1.2  # 1.1: 정답이 여러 개인 open 문항의 정답 목록 파싱 (normalize_gold) / 1.2: open 최종 답의 LaTeX 표기 정규화 (normalize_latex)
